# 从 https://cloud.siliconflow.cn/account/ak 获取
SILICONFLOW_API_KEY=请替换为你的硅基流动API密钥

# 通常无需修改
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct

# false 表示直连硅基流动，避免本机 HTTP(S)_PROXY 影响大图片请求。
# 只有网络必须经过系统代理时才改成 true。
SILICONFLOW_USE_SYSTEM_PROXY=false

# 直连在平台返回响应头之前失败时，自动切换系统代理重试一次。
SILICONFLOW_AUTO_NETWORK_FALLBACK=true
